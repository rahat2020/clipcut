# ─────────────────────────────────────────────────────────────
# worker/ environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — real keys never leave your machine.
# On Hugging Face Spaces these are set as Space secrets instead.
#
# Check everything with:  npm run check
# ─────────────────────────────────────────────────────────────

# ── Same values as web/.env.local ────────────────────────────
MONGODB_URI=
MONGODB_DB=ai_video_shorter
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dev

# ── AI (worker only) ─────────────────────────────────────────
# console.groq.com → API Keys (starts with gsk_)
GROQ_API_KEY=
# aistudio.google.com/apikey (starts with AIza… or AQ.…)
GEMINI_API_KEY=

# ── Local paths (defaults work if ffmpeg/yt-dlp are on PATH) ─
# Downloaded videos and renders go here. Relative to worker/.
SCRATCH_DIR=.scratch
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# debug | info | warn | error
LOG_LEVEL=info
