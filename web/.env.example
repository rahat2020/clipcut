# ─────────────────────────────────────────────────────────────
# web/ environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — real keys never leave your machine.
#
# ⚠ Next.js expands "$" inside values. If a key or password
#   contains "$", write it as "\$".
# Check everything with:  npm run check
# ─────────────────────────────────────────────────────────────

# ── Clerk (dashboard.clerk.com → your app → API Keys) ────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── MongoDB Atlas (Connect → Drivers) ────────────────────────
# Paste the full mongodb+srv://... string with your real password
# in place of <db_password>.
MONGODB_URI=
MONGODB_DB=ai_video_shorter

# ── Redis Cloud (database → Connect) ─────────────────────────
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=

# ── Cloudinary (dashboard → API Keys) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads go under this folder: "dev" locally, "prod" on Vercel
CLOUDINARY_FOLDER=dev

# ── Admin panel (used from Step 3) ───────────────────────────
# Comma-separated. Users who sign in with one of these verified
# emails become admins and can't be demoted from the UI.
ADMIN_EMAILS=

# ── Admin panel: AI models page (optional, Step 9 catch-up) ─
# Same keys as worker/.env.local. Only used to list models and for
# the "Test" button; the worker makes every real AI call.
GEMINI_API_KEY=
GROQ_API_KEY=
